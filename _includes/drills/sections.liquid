{% comment %}
  The drills page body: an index of sections, then each section's drills. Kept
  out of _pages/drills.md so it stays indented — prettier flattens HTML nested
  in Markdown. Wrapped in one element so kramdown passes it through untouched.
{% endcomment %}
<div class="drill-list">
  <nav class="drill-sections" aria-label="Sections">
    {%- for section in site.data.drill_sections -%}
      {%- assign drills = site.data.drills | where: 'section', section.id -%}
      {%- if drills.size > 0 %}
        <a href="#{{ section.id }}">{{ section.title }}</a>
      {%- endif -%}
    {%- endfor %}
  </nav>

  {% for section in site.data.drill_sections %}
    {% assign drills = site.data.drills | where: 'section', section.id %}
    {% if drills.size > 0 %}
      <section class="drill-section" id="{{ section.id }}">
        <h2>{{ section.title }}</h2>
        <div class="drills">
          {% for drill in drills %}
            <article class="drill" data-drill="{{ drill.id }}">
              <header class="drill-head">
                <h3>{{ drill.title }}</h3>
                <p class="drill-meta">{{ drill.category }}</p>
              </header>
              <div class="drill-stage">
                <svg viewBox="-30.6 -16.8 61.2 34.2" role="img" aria-label="{{ drill.title }} diagram">
                  <g class="trails"></g>
                  <g class="events"></g>
                  <g class="actors"></g>
                </svg>
                <div class="drill-controls">
                  <button type="button" class="drill-play" aria-label="Play drill">▶ Play</button>
                  <input type="range" min="0" max="1000" value="0" aria-label="Drill progress">
                  <button type="button" class="drill-reset" aria-label="Reset drill">↺</button>
                </div>
              </div>
              <div class="drill-side">
                {% if drill.steps %}
                  <ol class="drill-steps">
                    {% for step in drill.steps %}
                      <li data-t="{{ step.t }}">
                        <button type="button">{{ step.text }}</button>
                      </li>
                    {% endfor %}
                  </ol>
                {% endif %}
                {% if drill.notes %}
                  <p class="drill-notes">{{ drill.notes }}</p>
                {% endif %}
              </div>
            </article>
          {% endfor %}
        </div>
      </section>
    {% endif %}
  {% endfor %}
</div>
