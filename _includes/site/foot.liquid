<footer class="foot">
  <p>
    &copy; {{ site.time | date: '%Y' }}
    {{ site.first_name }}
    {{ site.last_name }}
  </p>
</footer>

<script>
  // Cycles system -> light -> dark. The pre-paint script in <head> applies the
  // stored choice; this only has to handle clicks and system changes.
  (function () {
    var r = document.documentElement;
    var btn = document.querySelector('[data-theme-toggle]');
    var label = document.querySelector('[data-theme-label]');
    var order = ['system', 'light', 'dark'];
    var glyph = { system: 'auto', light: 'light', dark: 'dark' };
    var mq = matchMedia('(prefers-color-scheme: dark)');

    function apply(setting) {
      var dark = setting === 'dark' || (setting === 'system' && mq.matches);
      r.setAttribute('data-theme-setting', setting);
      r.setAttribute('data-theme', dark ? 'dark' : 'light');
      if (label) label.textContent = glyph[setting];
      if (btn) btn.setAttribute('aria-label', 'Theme: ' + glyph[setting] + '. Change theme.');
      try {
        localStorage.setItem('theme-setting', setting);
      } catch (e) {}
    }

    apply(r.getAttribute('data-theme-setting') || 'system');

    if (btn)
      btn.addEventListener('click', function () {
        var now = r.getAttribute('data-theme-setting') || 'system';
        apply(order[(order.indexOf(now) + 1) % order.length]);
      });

    mq.addEventListener('change', function () {
      if ((r.getAttribute('data-theme-setting') || 'system') === 'system') apply('system');
    });
  })();
</script>

<script>
  // Menu panel. Closes on Escape, on outside click, and after following a link.
  (function () {
    var btn = document.querySelector('[data-menu-toggle]');
    var panel = document.querySelector('[data-menu]');
    if (!btn || !panel) return;

    function set(open) {
      btn.setAttribute('aria-expanded', String(open));
      btn.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
      panel.hidden = !open;
      document.documentElement.classList.toggle('menu-open', open);
    }

    btn.addEventListener('click', function () {
      set(btn.getAttribute('aria-expanded') !== 'true');
    });

    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape' && btn.getAttribute('aria-expanded') === 'true') {
        set(false);
        btn.focus();
      }
    });

    document.addEventListener('click', function (e) {
      if (btn.getAttribute('aria-expanded') !== 'true') return;
      if (panel.contains(e.target) || btn.contains(e.target)) return;
      set(false);
    });
  })();
</script>

<script>
  // Fades the sticky buttons once the page has scrolled beneath them.
  (function () {
    var head = document.querySelector('[data-site-head]');
    if (!head) return;
    function update() {
      head.classList.toggle('is-stuck', window.scrollY > 0);
    }
    window.addEventListener('scroll', update, { passive: true });
    update();
  })();
</script>
