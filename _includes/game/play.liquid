{% comment %}
  The game page body (assets/js/game.js): the scoreboard, the rink, and on
  touch screens a stick and two buttons. Kept out of _pages/play.md so it
  stays indented — prettier flattens HTML nested in the Markdown page.
{% endcomment %}
<div class="game" data-game>
  <div class="game-hud">
    <div class="game-board" data-board></div>
    <p class="game-buttons">
      <button type="button" data-pause>pause</button>
      <button type="button" data-view>view from above</button>
      <button type="button" data-restart>start again</button>
      <button type="button" data-sound>mute</button>
      <button type="button" class="game-exit" data-exit aria-label="Leave full screen">×</button>
    </p>
  </div>

  <div class="game-stage">
    <svg viewBox="-30.6 -16.8 61.2 34.2" role="img" aria-label="The rink, seen from above" tabindex="-1"></svg>
    <p class="game-toast" data-toast hidden></p>
    <p class="game-replay" data-replay hidden>Replay</p>
    <div class="game-fight" data-fight hidden>
      <p class="game-fight-side">
        <span data-fight-name="a"></span><span class="game-fight-bar"><i data-fight-bar="a"></i></span>
      </p>
      <p class="game-fight-keys" data-fight-keys></p>
      <p class="game-fight-side is-b">
        <span data-fight-name="b"></span><span class="game-fight-bar"><i data-fight-bar="b"></i></span>
      </p>
    </div>
    <div class="game-call" data-call hidden>
      <svg class="game-call-sign" viewBox="-1.75 -3.25 3.5 3.4" aria-hidden="true" data-call-sign></svg>
      <div>
        <p class="game-call-what" data-call-what></p>
        <p class="game-call-who" data-call-who></p>
        <p data-call-why></p>
        <p class="game-call-then" data-call-then></p>
      </div>
    </div>
    <div class="game-overlay" data-overlay hidden>
      <h2 data-overlay-title></h2>
      <p data-overlay-text></p>
      <p class="game-levels" data-sizes hidden>
        <button type="button" data-size="3">3 on 3</button>
        <button type="button" data-size="5">5 on 5</button>
      </p>
      <p class="game-levels" data-levels hidden>
        <button type="button" data-level="easy">easy</button>
        <button type="button" data-level="normal">normal</button>
        <button type="button" data-level="hard">hard</button>
      </p>
      <p class="game-overlay-buttons">
        <button type="button" data-overlay-button></button>
        <button type="button" class="is-quiet" data-overlay-alt hidden></button>
      </p>
    </div>
  </div>

  <p class="game-rotate">Turn your phone sideways for a bigger rink.</p>

  <div class="game-touch">
    <div class="game-stick" data-stick aria-label="Skate"><span data-knob></span></div>
    <div class="game-pads">
      <button type="button" class="game-pass" data-pass>pass</button>
      <button type="button" class="game-check" data-check>check</button>
      <button type="button" class="game-shoot" data-shoot>shoot</button>
    </div>
  </div>

  <p class="game-keys">
    <kbd>←</kbd><kbd>↑</kbd><kbd>↓</kbd><kbd>→</kbd> or <kbd>WASD</kbd> to skate · <kbd>Space</kbd> to shoot, or to poke the puck loose ·
    <kbd>X</kbd> to pass, to switch skater, or to win a faceoff · <kbd>C</kbd> to body check, or at a whistle to drop the gloves · <kbd>P</kbd> to
    pause
  </p>
  <p class="game-live" data-live aria-live="polite"></p>
</div>
