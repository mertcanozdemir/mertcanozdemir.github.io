{% comment %}
  A page without the site's chrome — no menu, no prose column — for things meant
  to be shared on their own, like the evidence graph. The page supplies its own
  stylesheet (front matter `stylesheet`) and header, including the theme button.
{% endcomment %}
<!doctype html>
<html lang="{{ site.lang | default: 'en' }}">
  <head>
    {% include site/head.liquid %}
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    {{ content }}
    {% include site/foot.liquid %}
  </body>
</html>
